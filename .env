# -----------------------------
# Prisma DB (APP tables only)
# -----------------------------
DATABASE_URL="mysql://root:@127.0.0.1:3306/cxo_prisma"

# -----------------------------
# WordPress DB (wpne_posts lives here)
# -----------------------------
WP_DATABASE_URL="mysql://root:@127.0.0.1:3306/cxo_portal"
WP_TABLE_PREFIX="wpne_"

# -----------------------------
# WordPress site URL (IMPORTANT)
# Put the EXACT URL where WP opens in browser
# Examples:
#   http://localhost/news-portal
#   http://localhost/wordpress
# -----------------------------
WP_SITE_URL="http://localhost/news-portal"

# -----------------------------
# WordPress root folder path (IMPORTANT)
# This is the folder that contains wp-content
# -----------------------------
WP_ROOT_PATH="C:/xampp/htdocs/news-portal"

# -----------------------------
# App / Auth
# -----------------------------
NEXTAUTH_SECRET="replace-me"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
SITE_URL="http://localhost:3000"

# -----------------------------
# Security
# -----------------------------
ADMIN_JWT_SECRET="change-this-to-a-long-random-secret"
CRON_SECRET="yourStrongSecret"
