# Your Next.js Prisma DB (your own tables: Post/Category/User/etc.)
DATABASE_URL="mysql://root:@127.0.0.1:3306/cxo_prisma"

# WordPress DB (where wp_posts/wp_postmeta exist)
WP_DATABASE_URL="mysql://root:@127.0.0.1:3306/cxo_portal"

# IMPORTANT: use correct table prefix
# If your tables are wp_posts, wp_postmeta -> use wp_
# If your tables are wpne_posts, wpne_postmeta -> use wpne_
WP_TABLE_PREFIX="wpne_"

WP_UPLOADS_PATH="C:/xampp-2/htdocs/news-portal/wp-content/uploads"
# Your Next.js site (used to build URLs)
WP_SITE_URL="http://localhost:3000"

# Path where wp-content/uploads exists (in your ZIP it is inside project)
WP_ROOT_PATH="C:/xampp-2/htdocs/news-portal"


