generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum PostStatus {
  DRAFT
  PUBLISHED
  SCHEDULED
  PRIVATE
  TRASH
}

//
// WordPress-like roles (recommended)
// If you want ONLY ADMIN/AUTHOR, remove others.
//
enum Role {
  ADMIN
  EDITOR
  AUTHOR
  CONTRIBUTOR
  SUBSCRIBER
}

model User {
  id           Int      @id @default(autoincrement())
  name         String
  username     String   @unique
  email        String?  @unique
  passwordHash String   @db.VarChar(255) // bcrypt hash

  bio          String?  @db.LongText
  avatar       String?  @db.LongText

  role         Role     @default(AUTHOR)
  posts        Post[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([role])
  @@index([createdAt])
}

model Category {
  id          Int        @id @default(autoincrement())
  name        String
  slug        String     @unique
  description String?    @db.LongText

  parentId    Int?
  parent      Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryParent")

  posts       Post[]
  createdAt   DateTime   @default(now())

  @@index([parentId])
}

model Setting {
  key   String @id
  value String @db.LongText
}

model Post {
  id          Int        @id @default(autoincrement())
  title       String
  slug        String     @unique
  excerpt     String?    @db.LongText
  content     String     @db.LongText

  thumbnail   String?    @db.LongText
  featured    Boolean    @default(false)
  trending    Boolean    @default(false)
  views       Int        @default(0)

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?  // scheduling

  authorId    Int
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  categoryId  Int
  category    Category   @relation(fields: [categoryId], references: [id])

  tags        String?    @db.LongText
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

    metaTitle       String?
  metaDescription String?
  ogImage         String?
  canonicalUrl    String?
  noIndex         Boolean   @default(false)


  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
}

model Media {
  id        Int      @id @default(autoincrement())
  title     String
  url       String   @db.LongText
  mimeType  String
  altText   String?  @db.LongText
  caption   String?  @db.LongText
  createdAt DateTime @default(now())
}

model WidgetArea {
  id        Int      @id @default(autoincrement())
  areaKey   String   @unique
  config    String   @db.LongText  // JSON
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}
